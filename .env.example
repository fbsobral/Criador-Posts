# Clerk — pegue as chaves em https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=SUA_PUBLISHABLE_KEY_AQUI
CLERK_SECRET_KEY=SUA_SECRET_KEY_AQUI

# Rotas de autenticação
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Multitenant: cada tenant = uma Organization do Clerk
# (ative em Dashboard → Configure → Organization settings)
NEXT_PUBLIC_CLERK_AFTER_CREATE_ORGANIZATION_URL=/
NEXT_PUBLIC_CLERK_AFTER_SELECT_ORGANIZATION_URL=/

# Banco de dados (qualquer Postgres: local, Neon, Supabase...)
DATABASE_URL=postgres://usuario:senha@localhost:5432/criador_posts

# Admins da plataforma (veem todos os usuários e criam templates globais) — e-mails separados por vírgula
PLATFORM_ADMIN_EMAILS=voce@exemplo.com
